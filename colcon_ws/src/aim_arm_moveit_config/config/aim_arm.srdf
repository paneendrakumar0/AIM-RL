<?xml version="1.0" encoding="UTF-8"?>
<robot name="aim_arm">
  <group name="arm">
    <chain base_link="base_link" tip_link="tool0"/>
  </group>

  <group_state name="home" group="arm">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-0.8"/>
    <joint name="elbow_joint" value="1.6"/>
    <joint name="wrist_pitch_joint" value="-0.8"/>
    <joint name="wrist_roll_joint" value="0"/>
    <joint name="wrist_yaw_joint" value="0"/>
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.0"/>
    <joint name="elbow_joint" value="2.0"/>
    <joint name="wrist_pitch_joint" value="-1.0"/>
    <joint name="wrist_roll_joint" value="0"/>
    <joint name="wrist_yaw_joint" value="0"/>
  </group_state>

  <disable_collisions link1="base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_pitch_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_pitch_link" link2="wrist_roll_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_roll_link" link2="tool_link" reason="Adjacent"/>
  <disable_collisions link1="tool_link" link2="tool0" reason="Adjacent"/>
</robot>

